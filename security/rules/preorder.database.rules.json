{
  "rules": {
    ".read": false,
    ".write": false,
    "deletionAuthorizations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "reservations": {
      ".read": "auth != null && auth.token.aliceApp === 'preorder' && auth.token.aliceRole === 'staff'",
      "$reservationId": {
        ".write": "auth != null && auth.uid != null && auth.token.aliceApp === 'preorder' && auth.token.aliceRole === 'staff' && ((!data.exists() && newData.exists()) || (data.exists() && newData.exists()) || (data.exists() && !newData.exists() && root.child('deletionAuthorizations').child(auth.uid).val() === true))",
        ".validate": "newData.hasChildren(['id', 'reservationDate', 'customerName', 'contactPlatform', 'product', 'quantity', 'phone', 'pickupDate', 'createdAt'])",
        "id": { ".validate": "(!data.exists() && newData.isNumber()) || (data.exists() && newData.val() === data.val())" },
        "reservationDate": { ".validate": "(!data.exists() && newData.isString()) || (data.exists() && newData.val() === data.val())" },
        "customerName": { ".validate": "(!data.exists() && newData.isString()) || (data.exists() && newData.val() === data.val())" },
        "contactPlatform": { ".validate": "(!data.exists() && newData.isString()) || (data.exists() && newData.val() === data.val())" },
        "product": { ".validate": "(!data.exists() && newData.isString()) || (data.exists() && newData.val() === data.val())" },
        "quantity": { ".validate": "(!data.exists() && newData.isNumber()) || (data.exists() && newData.val() === data.val())" },
        "phone": { ".validate": "(!data.exists() && newData.isString()) || (data.exists() && newData.val() === data.val())" },
        "pickupDate": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "(!data.exists() && newData.isNumber()) || (data.exists() && newData.val() === data.val())" },
        "$other": { ".validate": "data.exists() && newData.exists() && newData.val() === data.val()" }
      }
    }
  }
}
