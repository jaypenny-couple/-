rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /salon/main {
      allow read, write: if request.auth != null
        && request.auth.token.aliceApp == 'hr'
        && request.auth.token.aliceRole == 'manager';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
